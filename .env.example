# MAOS environment configuration template.
# Copy to `.env` for local development. Real secrets load from a managed
# secrets source at runtime (Vault / cloud KMS) and are never committed (TC-13).

# --- Postgres (checkpointer + tables, pgvector, code graph) ---
MAOS_POSTGRES_DSN=postgresql://maos:maos@localhost:5432/maos

# --- Dragonfly (Redis-compatible: Shared_Context, cache, broker) ---
MAOS_REDIS_URL=redis://localhost:6379/0
MAOS_BROKER_URL=redis://localhost:6379/1
MAOS_DRAGONFLY_CACHE_URL=redis://localhost:6379/2

# --- LLM providers (used ONLY behind the LLM_Provider_Adapter) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AWS_REGION=

# --- Security ---
SECRET_KEY=your-super-secret-key-change-in-production

# --- Budgets ---
MAOS_DEFAULT_TASK_TOKEN_BUDGET=100000
MAOS_TENANT_DAILY_TOKEN_CEILING=5000000

# --- Concurrency ---
MAOS_GLOBAL_CONCURRENCY_CAP=100
MAOS_TENANT_CONCURRENCY_CAP=10

# --- Observability (optional for local dev) ---
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# LANGSMITH_API_KEY=ls-your-key
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ===========================================================================
# Coolify Deployment Notes
# ===========================================================================
# When deploying to Coolify, set these environment variables in the dashboard:
#   DATABASE_URL      - Your Coolify-managed PostgreSQL 18 connection string
#   DRAGONFLY_URL     - Your Coolify-managed Dragonfly connection string
#   SECRET_KEY        - A strong random secret for JWT signing
#   ANTHROPIC_API_KEY - Your Anthropic API key
#
# Use docker-compose.coolify.yml for production deployment.
# Use docker-compose.local.yml for local development (includes all services).
