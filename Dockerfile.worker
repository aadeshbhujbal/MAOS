# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Dockerfile.worker — Multi-stage build for MAOS Arq orchestration workers
#
# Stateless workers that pull Tasks from the Redis broker queue and run the
# LangGraph orchestration graph. No exposed port — workers communicate via
# the broker and Postgres checkpointer.
#
# Requirements: 14.1, 14.2, 14.3, 14.5, TC-8, TC-12
# ---------------------------------------------------------------------------

# ===========================================================================
# Stage 1: builder — install dependencies with uv
# ===========================================================================
FROM python:3.12-slim AS builder

# Install system deps needed for building psycopg (libpq)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast, deterministic dependency resolution
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir uv==0.5.11

WORKDIR /build

# Copy dependency manifest first for layer caching
COPY --link pyproject.toml ./
COPY --link src/ ./src/

# Install production dependencies into a virtual environment
RUN uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    uv pip install --no-cache .

# ===========================================================================
# Stage 2: runtime — minimal image with installed packages
# ===========================================================================
FROM python:3.12-slim AS runtime

LABEL maintainer="Healthcare Platform Team"
LABEL org.opencontainers.image.title="maos-worker"
LABEL org.opencontainers.image.description="MAOS orchestration worker — Arq + LangGraph"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.source="https://github.com/healthcare-platform/maos"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.vendor="Healthcare Platform Team"

# Install runtime system deps: libpq for psycopg
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --link --from=builder /opt/venv /opt/venv

# Set PATH to use the virtual environment
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Create non-root user for security
RUN groupadd --gid 1000 maos && \
    useradd --uid 1000 --gid 1000 --no-create-home --shell /sbin/nologin maos

USER maos

# No EXPOSE — workers pull from broker queue, no inbound connections needed

CMD ["arq", "maos.workers.orchestration.OrchestrationWorkerSettings"]
